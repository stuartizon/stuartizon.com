---
import Icon from '../components/Icon.astro';
import Analytics from '@vercel/analytics/astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/outfit';

interface Props {
  title: string;
  description?: string;
  fullTitle?: boolean;
}

const {
  title,
  description = 'Stuart Izon — software engineer, chazzan, and choir director.',
  fullTitle = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = fullTitle ? title : `${title} — Stuart Izon`;
const ogImage = new URL('/images/og.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Stuart Izon" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header>
      <nav class="nav">
        <a href="/" class="nav-brand">Stuart Izon</a>
        <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <ul class="nav-links">
          <li><a href="/engineering">Engineering</a></li>
          <li><a href="/music">Music</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-inner">
        <p class="footer-credit">
          &copy; {new Date().getFullYear()} Stuart Izon. Built with
          <a href="https://astro.build" target="_blank" rel="noopener" class="footer-tech">
            <Icon name="astro" size={14} />
            Astro
          </a>
          and hosted on
          <a href="https://vercel.com" target="_blank" rel="noopener" class="footer-tech">
            <Icon name="vercel" size={12} />
            Vercel
          </a>
        </p>
        <nav class="footer-links">
          <a href="https://github.com/stuartizon" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.linkedin.com/in/stuart-izon/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://www.youtube.com/@stuartizon" target="_blank" rel="noopener">YouTube</a>
        </nav>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
      const links = document.querySelector('.nav-links') as HTMLElement;
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        links?.classList.toggle('open');
      });
    </script>
    <Analytics />
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --color-bg: #faf8f5;
    --color-text: #1c1917;
    --color-muted: #57534e;
    --color-faint: #a8a29e;
    --color-border: #e7e5e4;
    --color-surface: #f0ece6;
    --color-accent: #166e6e;
    --color-accent-muted: #4a9e9e;
    --font-display: 'Outfit Variable', 'Outfit', system-ui, sans-serif;
    --font-sans: 'Inter Variable', 'Inter', system-ui, sans-serif;
    --max-width: 1100px;
    --page-padding: clamp(1.5rem, 5vw, 3rem);
  }

  html {
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.7;
    background: var(--color-bg);
    color: var(--color-text);
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-display);
    line-height: 1.2;
    font-weight: 600;
  }

  h1 { font-size: clamp(2.25rem, 5.5vw, 4rem); font-weight: 600; letter-spacing: -0.02em; }
  h2 { font-size: clamp(1.5rem, 3.5vw, 2.25rem); font-weight: 600; letter-spacing: -0.01em; }
  h3 { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 600; }

  img { max-width: 100%; display: block; }

  .page-label {
    display: block;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.75rem;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--page-padding);
  }

  .section {
    padding: clamp(2.5rem, 7vw, 5rem) 0;
  }

  @media (max-width: 768px) {
    .section {
      padding: 2rem 0;
    }
  }

  /* Nav */
  header {
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: rgba(250,248,245,0.96);
    backdrop-filter: blur(8px);
    z-index: 100;
  }

  .nav {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--page-padding);
    height: 64px;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-brand {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-right: auto;
    white-space: nowrap;
  }

  .nav-brand:hover { color: var(--color-accent); }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
  }

  .nav-links a {
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-muted);
    transition: color 0.15s;
  }

  .nav-links a:hover { color: var(--color-accent); }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--color-text);
    transition: transform 0.2s;
  }

  @media (max-width: 640px) {
    .nav-toggle { display: flex; }

    .nav-links {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
    }

    .nav-links.open { display: flex; }

    .nav-links li { border-top: 1px solid var(--color-border); }

    .nav-links a {
      display: block;
      padding: 1rem var(--page-padding);
    }
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--page-padding);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a:hover { color: var(--color-accent); }

  .footer-credit {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .footer-tech {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    transition: color 0.15s;
  }

  .footer-tech:hover { color: var(--color-accent); }

  .footer-tech svg {
    opacity: 0.7;
  }
</style>
