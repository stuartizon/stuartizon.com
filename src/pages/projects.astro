---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Projects"
  description="A selection of projects by Stuart Izon — spanning engineering and music."
>
  <section class="section">
    <div class="container">
      <SectionHeader
        label="Work"
        title="Projects"
        subtitle="A selection of things I've built — spanning engineering, music, and the occasional intersection of both."
        level={1}
      />
      <div class="projects-grid">
        {projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            url={project.data.url}
            githubUrl={project.data.githubUrl}
            youtubeUrl={project.data.youtubeUrl}
            tags={project.data.tags}
            domain={project.data.domain}
          />
        ))}
      </div>

    </div>
  </section>
</Layout>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
  }

</style>
