---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Stuart Izon — software engineer, chazzan, and choir director.">
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-text">
          <p class="hero-label">Stuart Izon</p>
          <h1>Software engineer.<br />Chazzan.<br />Choir director.</h1>
          <div class="hero-body">
            <p>
              I'm a software engineer with more than fifteen years of experience building
              large-scale systems, leading engineering teams, and helping organisations
              deliver complex technology projects.
            </p>
            <p>
              Outside technology, I'm active in Jewish liturgical music as a chazzan,
              choir director, arranger, and researcher. I lead services, direct choirs,
              and maintain an archive of historic synagogue music through the
              Shira v'Zimra project.
            </p>
            <p>
              I'm currently based in Israel and available for both technology
              opportunities and musical engagements.
            </p>
          </div>
          <nav class="hero-cta">
            <a href="/engineering" class="btn btn-primary">Engineering</a>
            <a href="/music" class="btn btn-secondary">Music</a>
          </nav>
        </div>
        <div class="hero-image">
          <img src="/images/stuart.jpg" alt="Stuart Izon" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: clamp(2.5rem, 7vw, 5rem) 0;
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 5rem;
    align-items: start;
  }

  .hero-label {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  h1 {
    margin-bottom: 2rem;
  }

  .hero-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-muted);
    margin-bottom: 2.5rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: all 0.15s;
  }

  .btn-primary {
    background: var(--color-accent);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--color-text);
  }

  .btn-secondary {
    border: 1px solid var(--color-text);
    color: var(--color-text);
  }

  .btn-secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero-image {
    flex-shrink: 0;
    padding-top: 2.5rem;
  }

  .hero-image img {
    width: 360px;
    height: 360px;
    object-fit: cover;
    object-position: center 15%;
    border-radius: 8px;
  }

  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-image {
      display: none;
    }

    .hero {
      padding: 2rem 0;
      min-height: auto;
    }
  }
</style>
