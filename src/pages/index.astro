---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import stuartPhoto from '../assets/stuart.jpg';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Stuart Izon" description="Stuart Izon — software engineer, chazzan, and choir director." fullTitle>

  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <div class="hero-text">
          <p class="hero-label">Stuart Izon</p>
          <h1>Software engineer.<br />Based in Tel Aviv.</h1>
          <div class="hero-body">
            <p>
              I'm a software engineer with over fifteen years of experience building
              large-scale systems and leading engineering teams. Outside technology,
              I'm actively involved in Jewish liturgical music as a chazzan, choir
              director, arranger, and researcher. I'm currently based in Israel.
            </p>
          </div>
          <a href="/cv.pdf" class="cv-btn cv-btn-mobile" style="display:none" download="Stuart Izon CV.pdf">Download CV</a>
        </div>
        <div class="hero-image">
          <Image src={stuartPhoto} alt="Stuart Izon" width={720} />
          <a href="/cv.pdf" class="cv-btn" download="Stuart Izon CV.pdf">Download CV</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container">
      <SectionHeader
        label="Work"
        title="Featured projects"
      />
      <div class="projects-grid">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            url={project.data.url}
            githubUrl={project.data.githubUrl}
            youtubeUrl={project.data.youtubeUrl}
            tags={project.data.tags}
            domain={project.data.domain}
          />
        ))}
      </div>
      <a href="/projects" class="all-projects">All projects →</a>
    </div>
  </section>


</Layout>

<style>
  .hero {
    padding: clamp(2.5rem, 7vw, 5rem) 0;
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 5rem;
    align-items: start;
  }

  .hero-label {
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  h1 {
    margin-bottom: 2rem;
  }

  .hero-body {
    color: var(--color-muted);
    margin-bottom: 2.5rem;
  }

  .hero-image {
    flex-shrink: 0;
    padding-top: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
  }

  .hero-image img {
    width: 360px;
    height: 360px;
    object-fit: cover;
    object-position: center 15%;
    border-radius: 8px;
  }

  .cv-btn {
    display: block;
    text-align: center;
    padding: 0.7rem 1.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--color-accent);
    color: #fff;
    transition: background 0.15s;
  }

  .cv-btn:hover {
    background: var(--color-text);
  }


  /* Featured projects */
  .bg-surface { background: var(--color-surface); }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .all-projects {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-muted);
    transition: color 0.15s;
  }

  .all-projects:hover { color: var(--color-accent); }

  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-image { display: none; }
    .cv-btn-mobile { display: block !important; }

    .hero {
      padding: 2rem 0;
      min-height: auto;
    }

    .split {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
