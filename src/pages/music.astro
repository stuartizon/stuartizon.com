---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { Image } from 'astro:assets';
import shiraVZimraCover from '../assets/shira-vzimra.png';

const synagogues = [
  { venue: 'Young Israel of New Hyde Park', location: 'New York, USA', url: 'https://www.yinhp.org/' },
  { venue: 'The Jewish Center', location: 'New York, USA', url: 'https://jewishcenter.org' },
  { venue: 'Congregation Ohab Zedek', location: 'New York, USA', url: 'https://ozny.org' },
  { venue: 'Hampton Synagogue', location: 'New York, USA', url: 'https://thehamptonsynagogue.org' },
  { venue: 'Birmingham Central Synagogue', location: 'Birmingham, UK', url: 'https://centralshul.com' },
  { venue: 'West Side Institutional Synagogue', location: 'New York, USA', url: 'https://wsisny.org' },
];

const choirDirection = [
  {
    name: 'Western Marble Arch Synagogue',
    location: 'London, UK',
    url: 'https://www.marblearch.org.uk/',
    note: 'I conducted and arranged for the High Holiday services choir for ten years, working with chazzan Lionel Rosenfeld.',
  },
  {
    name: 'Shabbaton Choir',
    location: 'London, UK',
    url: 'https://www.shabbatonchoir.com/',
    note: 'A world-renowned, UK-based Jewish choral ensemble that specializes in elevating synagogue services and concerts worldwide through highly distinctive, harmony-driven cantorial arrangements. I was associate conductor, arranger, and accompanist for over ten years, working with musical director Stephen Levey.',
  },
  {
    name: 'Kol Simcha Choir',
    location: 'Melbourne, Australia',
    note: 'Director of the choir at South Caulfield Synagogue.',
  },
  {
    name: 'West Side Choir',
    location: 'New York, USA',
    note: 'Musical director of a small community choir at the Jewish Center.',
  },
];

const ensembles = [
  {
    name: 'Zingers Choir',
    url: 'https://www.instagram.com/thezingerschoir/',
    note: 'A New York-based Jewish vocal ensemble that excels at elevating communal Shabbatot and headlining cantorial concerts alongside legendary, world-renowned chazzanim.',
  },
  {
    name: 'Neimah Singers',
    url: 'https://www.facebook.com/neimahsingers/',
    note: "London's leading male-voice Jewish liturgical choir, known for performing traditional and contemporary synagogue music at major communal and broadcast events.",
  },
  {
    name: 'MSO Chorus',
    url: 'https://www.mso.com.au/behind-the-music/mso-chorus',
    note: "The Melbourne Symphony Orchestra's resident chorus, performing large-scale choral works with the orchestra and guest conductors.",
  },
  {
    name: 'Oratorio Society of New York',
    url: 'https://osny.org/',
    note: "One of New York's leading choral societies, performing large-scale oratorio repertoire under Music Director Kent Tritle.",
  },
];
---

<Layout
  title="Music"
  description="Stuart Izon is a chazzan, choir director, arranger, and researcher of Jewish liturgical music."
>
  <section class="hero section">
    <div class="container">
      <p class="page-label">Music</p>
      <h1>Chazzan. Choir director.<br />Researcher.</h1>
      <div class="hero-bio">
        <p>
          Alongside my engineering career, I have been active in Jewish liturgical music
          for more than twenty years, as a choir director, as an arranger, and as a
          chorister. I have also served as a chazzan for many years, and have since
          undertaken formal study in chazzanut and vocal training to bring further
          rigour to that practice. More recently, I've begun exploring the musicology
          and history of synagogue melodies through my <a href="#shira-vzimra">Shira v'Zimra</a> project.
        </p>
        <p>
          I have led services and directed choirs in synagogues across the United
          Kingdom, the United States, and Australia.
        </p>
      </div>
      <a href="/contact" class="btn">Get in touch</a>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container">
      <SectionHeader label="Guest Chazzan" title="Synagogue service" />
      <p class="section-intro">I have recently appeared as guest chazzan at the following congregations, among others.</p>
      <ul class="engagement-list">
        {synagogues.map(({ venue, location, url }) => (
          <li class="engagement-item">
            <h3>
              <a href={url} target="_blank" rel="noopener" class="engagement-venue">{venue}</a>
            </h3>
            <p class="engagement-location">{location}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader label="Choral music" title="Direction & ensembles" />
      <div class="choral-grid">
        <div class="choral-group">
          <h3 class="choral-group-title">Choir direction</h3>
          <ul class="choral-list">
            {choirDirection.map(({ name, location, url, note }) => (
              <li>
                <div class="choral-header">
                  {url ? (
                    <a href={url} target="_blank" rel="noopener" class="choral-name">{name}</a>
                  ) : (
                    <span class="choral-name">{name}</span>
                  )}
                  <span class="choral-location">{location}</span>
                </div>
                {note && <p class="choral-note">{note}</p>}
              </li>
            ))}
          </ul>
        </div>
        <div class="choral-group">
          <h3 class="choral-group-title">Ensemble membership</h3>
          <ul class="choral-list">
            {ensembles.map(({ name, url, note }) => (
              <li>
                <div class="choral-header">
                  {url ? (
                    <a href={url} target="_blank" rel="noopener" class="choral-name">{name}</a>
                  ) : (
                    <span class="choral-name">{name}</span>
                  )}
                </div>
                {note && <p class="choral-note">{note}</p>}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="shira-vzimra" class="section bg-surface">
    <div class="container">
      <div class="svz-content">
        <div class="svz-text">
          <SectionHeader label="Project" title="Shira v'Zimra" />
          <div class="svz-body">
            <p>
              Shira v'Zimra (שירה וזמרה — "Song and Music") is a project dedicated to
              preserving and illuminating synagogue music. At its heart is a book of choral
              arrangements for male voice choir. During the Covid-19 pandemic, I started to
              record multitrack performances of these settings, with my
              own voice layered into four-part harmony as an aural companion to the
              scores.
            </p>
            <p>
              The project aims to resurface forgotten melodies, document a rich and
              sometimes overlooked repertoire, and make it freely accessible to chazzanim,
              ba'alei t'filah, choirs, and communities worldwide through YouTube and other
              platforms.
            </p>
            <div class="svz-ctas">
              <a
                href="https://shiravzimra.com"
                target="_blank"
                rel="noopener"
                class="btn"
              >
                Get the book
              </a>
              <a
                href="https://www.youtube.com/@stuartizon"
                target="_blank"
                rel="noopener"
                class="btn btn-outline"
              >
                Watch on YouTube
              </a>
            </div>
          </div>
        </div>
        <div class="svz-cover">
          <Image src={shiraVZimraCover} alt="Shira v'Zimra book cover" width={400} format="webp" quality={80} />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader label="Composition" title="Arrangements" />
      <div class="arrangements-text">
        <p>
          I have written vocal arrangements for a wide range of choirs and
          ensembles, scoring for mixed voices as well as for male voice choir.
          For male voice choir, I write in the MATB format (Melody, Alto,
          Tenor, Bass) rather than the more traditional TTBB. This keeps the
          melody prominent on the page and to the ear, with a spacious
          harmonic texture; the Tenor part, which often sits above the
          melody, is sung lightly (sometimes in falsetto) so that it
          supports rather than competes with the tune.
        </p>
        <p>
          All of my published arrangements can be downloaded for free from my
          Shira v'Zimra project at
          <a href="https://shiravzimra.com" target="_blank" rel="noopener">shiravzimra.com</a>.
        </p>
        <p>
          I'm also available to write custom arrangements for your choir or
          ensemble - whether rescoring an existing piece or arranging a new
          work - always aiming for results that are singable, practical, and
          musically satisfying.
        </p>
      </div>
      <a href="/contact" class="btn">Contact me about an arrangement</a>
    </div>
  </section>
</Layout>

<style>
  .hero h1 {
    margin-bottom: 2rem;
  }

  .hero-bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-muted);
    margin-bottom: 2.5rem;
  }

  .hero-bio a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .hero-bio a:hover {
    opacity: 0.65;
  }

  .section-intro {
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--color-accent);
    color: #fff;
    transition: background 0.15s;
  }

  .btn:hover { background: var(--color-text); }

  .btn-outline {
    background: transparent;
    color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-muted);
  }

  .btn-outline:hover {
    background: var(--color-text);
    color: #fff;
  }

  .bg-surface { background: var(--color-surface); }

  .engagement-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 2rem;
  }

  .engagement-item {
    border-left: 2px solid var(--color-accent-muted);
    padding-left: 1.5rem;
  }

  .engagement-item h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .engagement-venue {
    color: var(--color-text);
    text-decoration: none;
  }

  a.engagement-venue:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .engagement-location {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .choral-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 3rem;
  }

  .choral-group-title {
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }

  .choral-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .choral-list li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.8rem;
  }

  .choral-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .choral-name {
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
  }

  a.choral-name:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .choral-location {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .choral-note {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .svz-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .svz-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .svz-body p {
    color: var(--color-muted);
  }

  .svz-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .svz-cover img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.15);
  }

  @media (max-width: 768px) {
    .svz-content {
      grid-template-columns: 1fr;
    }

    .svz-cover {
      display: none;
    }
  }

  .arrangements-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .arrangements-text a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .arrangements-text a:hover { opacity: 0.65; }
</style>
