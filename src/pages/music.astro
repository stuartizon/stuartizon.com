---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getCollection } from 'astro:content';

const engagements = (await getCollection('engagements')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Music"
  description="Stuart Izon is a chazzan, choir director, arranger, and researcher of Jewish liturgical music."
>
  <section class="hero section">
    <div class="container">
      <p class="page-label">Music</p>
      <h1>Chazzan. Choir director.<br />Researcher.</h1>
      <div class="hero-bio">
        <p>
          Alongside my engineering career, I have been active in Jewish liturgical music
          for more than twenty years as a chazzan (cantor), choir director, arranger,
          and researcher.
        </p>
        <p>
          I have led services and directed choirs in synagogues across the United
          Kingdom, the United States, and Israel, working within the Western Ashkenazi
          tradition.
        </p>
        <p>
          I am available for engagements as a guest chazzan, choir director, arranger,
          and musical consultant.
        </p>
      </div>
      <a href="/contact" class="btn">Get in touch</a>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container">
      <SectionHeader
        label="Chazzan"
        title="Synagogue service"
        subtitle="I have served as chazzan at the following congregations and as a guest in many others."
      />
      <ul class="engagement-list">
        {engagements.map(({ data }) => (
          <li class="engagement-item">
            <span class="engagement-venue">{data.venue}</span>
            {data.location && <span class="engagement-location">{data.location}</span>}
            {data.period && <span class="engagement-period">{data.period}</span>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        label="Project"
        title="Shira v'Zimra"
        subtitle="An archive of historic Western Ashkenazi synagogue music."
      />
      <div class="svz-content">
        <div class="svz-text">
          <p>
            Shira v'Zimra (שירה וזמרה — "Song and Music") is a project dedicated to
            preserving and disseminating the Western Ashkenazi synagogue music tradition.
          </p>
          <p>
            The project encompasses original recordings, arrangements, and educational
            content, made freely available through YouTube and other platforms. It aims
            to document a rich and sometimes overlooked repertoire, making it accessible
            to cantors, choir directors, and communities worldwide.
          </p>
          <a
            href="https://www.youtube.com/@ShiravZimra"
            target="_blank"
            rel="noopener"
            class="btn"
          >
            Watch on YouTube
          </a>
        </div>
        <div class="svz-embed">
          <p class="embed-note">
            <!-- Replace with an embedded YouTube playlist -->
            <a href="https://www.youtube.com/@ShiravZimra" target="_blank" rel="noopener">
              View the Shira v'Zimra channel →
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container">
      <SectionHeader
        label="Availability"
        title="Engagements"
        subtitle="I am available for the following types of musical engagement."
      />
      <ul class="availability-list">
        <li>
          <h3>Guest Chazzan</h3>
          <p>Available for Shabbat, Yom Tov, and High Holiday services.</p>
        </li>
        <li>
          <h3>Choir Director</h3>
          <p>Directing and training synagogue choirs and choral ensembles.</p>
        </li>
        <li>
          <h3>Arranger</h3>
          <p>Arrangements of liturgical music for voices and ensemble.</p>
        </li>
        <li>
          <h3>Musical Consultant</h3>
          <p>Advising on repertoire, programme design, and musical direction.</p>
        </li>
      </ul>
      <p class="availability-cta">
        <a href="/contact" class="btn">Contact me about an engagement</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero h1 {
    margin-top: 1rem;
    margin-bottom: 2rem;
  }

  .page-label {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-muted);
    margin-bottom: 2.5rem;
    max-width: 68ch;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--color-accent);
    color: #fff;
    transition: background 0.15s;
  }

  .btn:hover { background: var(--color-text); }

  .bg-surface { background: var(--color-surface); }

  .engagement-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .engagement-item {
    border: 1px solid var(--color-border);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--color-bg);
  }

  .engagement-venue {
    font-size: 1.05rem;
    font-weight: 500;
  }

  .engagement-location, .engagement-period {
    font-size: 0.8rem;
    color: var(--color-faint);
  }

  .svz-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .svz-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .svz-text p { color: var(--color-muted); }

  .svz-text .btn { margin-top: 0.75rem; align-self: flex-start; }

  .svz-embed {
    border: 1px solid var(--color-border);
    aspect-ratio: 16/9;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
  }

  .embed-note {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-align: center;
  }

  .embed-note a:hover { opacity: 0.65; }

  .availability-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .availability-list li {
    border-left: 2px solid var(--color-accent-muted);
    padding-left: 1.5rem;
  }

  .availability-list h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .availability-list p {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .availability-cta { margin-top: 1rem; }

  @media (max-width: 768px) {
    .svz-content { grid-template-columns: 1fr; }
    .svz-embed { display: none; }
  }
</style>
