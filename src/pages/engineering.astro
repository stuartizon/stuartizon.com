---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const expertise = [
  { area: 'Distributed Systems', detail: 'Designing and building large-scale event-driven and microservice architectures' },
  { area: 'Technical Leadership', detail: 'Leading engineering teams, defining strategy, and mentoring engineers at all levels' },
  { area: 'Full-Stack Development', detail: 'End-to-end delivery across frontend, backend, and infrastructure' },
  { area: 'Product Discovery', detail: 'Working with stakeholders to define, prioritise, and shape product direction' },
  { area: 'Architecture', detail: 'System design, platform evolution, and technology strategy across complex organisations' },
];

const experience = [
  {
    organisation: 'Thoughtworks',
    role: 'Senior Consultant / Lead Engineer',
    period: '2013 – 2019',
    description: 'Delivered complex technology projects for clients across financial services, energy, and the public sector. Led teams building distributed systems and drove technical strategy.',
  },
  {
    organisation: 'OVO Energy',
    role: 'Principal Engineer',
    period: '2019 – 2022',
    description: 'Principal engineer in the platform organisation during a period of rapid growth. Focused on event-driven architecture, developer experience, and platform scalability.',
  },
  {
    organisation: 'Detica (BAE Systems)',
    role: 'Software Engineer',
    period: '2009 – 2013',
    description: 'Built data processing and analytics systems for government and defence clients. Worked in teams delivering mission-critical software.',
  },
];
---

<Layout
  title="Engineering"
  description="Stuart Izon is a senior software engineer and technical leader with more than 15 years of experience."
>
  <section class="hero section">
    <div class="container">
      <p class="page-label">Engineering</p>
      <h1>Building software that scales.</h1>
      <div class="hero-bio">
        <p>
          I'm a senior software engineer and technical leader with more than fifteen years
          of experience building large-scale distributed systems and leading engineering
          teams across financial services, energy, government, and media.
        </p>
        <p>
          I've worked across the full stack — from product discovery and architecture
          through to delivery and operations — often in environments where technical
          decisions have real organisational consequences.
        </p>
        <p>
          I care about clear technical thinking, well-structured systems, and building
          teams that can deliver and grow together.
        </p>
      </div>
      <a href="/cv.pdf" class="btn" download="Stuart Izon CV.pdf">Download CV</a>
    </div>
  </section>

  <section class="section bg-surface">
    <div class="container">
      <SectionHeader label="Expertise" title="What I do" />
      <ul class="expertise-list">
        {expertise.map(({ area, detail }) => (
          <li class="expertise-item">
            <h3>{area}</h3>
            <p>{detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader label="Career" title="Selected experience" />
      <div class="experience-list">
        {experience.map(({ organisation, role, period, description }) => (
          <div class="experience-item">
            <div class="experience-meta">
              <h3>{organisation}</h3>
              <span class="experience-role">{role}</span>
              <span class="experience-period">{period}</span>
            </div>
            <p>{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero h1 {
    margin-top: 1rem;
    margin-bottom: 2rem;
  }

  .page-label {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .hero-bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-muted);
    margin-bottom: 2.5rem;
    max-width: 68ch;
  }

  .btn {
    display: inline-block;
    padding: 0.8rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--color-accent);
    color: #fff;
    transition: background 0.15s;
  }

  .btn:hover { background: var(--color-text); }

  .bg-surface { background: var(--color-surface); }

  .expertise-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }

  .expertise-item {
    border-left: 2px solid var(--color-accent-muted);
    padding-left: 1.5rem;
  }

  .expertise-item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .expertise-item p {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid var(--color-border);
  }

  .experience-item {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .experience-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .experience-meta h3 {
    font-size: 1.15rem;
  }

  .experience-role {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .experience-period {
    font-size: 0.8rem;
    color: var(--color-faint);
    margin-top: 0.25rem;
  }

  .experience-item p {
    color: var(--color-muted);
    font-size: 0.95rem;
    align-self: center;
  }

  @media (max-width: 640px) {
    .experience-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
