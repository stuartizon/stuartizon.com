---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Stuart Izon."
>
  <section class="section">
    <div class="container">
      <SectionHeader
        label="Get in touch"
        title="Contact"
      />
      <p class="availability">Currently based in Israel. Open to lead engineering roles, remote consulting, and musical engagements.</p>

      <ul class="contact-links">
        <li>
          <a href="mailto:stuart.izon@gmail.com">
            <Icon name="email" size={18} />
            stuart.izon@gmail.com
          </a>
        </li>
        <li>
          <a href="https://www.linkedin.com/in/stuart-izon/" target="_blank" rel="noopener">
            <Icon name="linkedin" size={18} />
            LinkedIn
          </a>
        </li>
        <li>
          <a href="https://github.com/stuartizon" target="_blank" rel="noopener">
            <Icon name="github" size={18} />
            GitHub
          </a>
        </li>
        <li>
          <a href="https://www.youtube.com/@stuartizon" target="_blank" rel="noopener">
            <Icon name="youtube" size={18} />
            YouTube
          </a>
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .availability {
    color: var(--color-muted);
    margin-bottom: 2rem;
  }

  .contact-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    max-width: 360px;
  }

  .contact-links a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
    transition: color 0.15s;
  }

  .contact-links li:first-child a {
    border-top: 1px solid var(--color-border);
  }

  .contact-links a:hover { color: var(--color-accent); }
</style>
