---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Stuart Izon for engineering or musical engagements."
>
  <section class="section">
    <div class="container">
      <SectionHeader
        label="Get in touch"
        title="Contact"
        subtitle="I'm happy to hear from recruiters, organisations looking for a chazzan or choir director, or anyone with an interesting project."
      />

      <div class="contact-grid">
        <div class="contact-block">
          <h3>Engineering</h3>
          <p>
            For technology opportunities, consulting work, or technical collaborations —
            please email me directly or connect on LinkedIn.
          </p>
          <ul class="contact-links">
            <li>
              <a href="mailto:stuart.izon@gmail.com">stuart.izon@gmail.com</a>
            </li>
            <li>
              <a href="https://linkedin.com/in/stuartizon" target="_blank" rel="noopener">
                LinkedIn
              </a>
            </li>
            <li>
              <a href="https://github.com/stuartizon" target="_blank" rel="noopener">
                GitHub
              </a>
            </li>
          </ul>
        </div>

        <div class="contact-block">
          <h3>Music</h3>
          <p>
            For chazzanut, choir direction, arranging, or musical consultancy enquiries —
            synagogues and Jewish organisations are welcome to get in touch.
          </p>
          <ul class="contact-links">
            <li>
              <a href="mailto:stuart.izon@gmail.com">stuart.izon@gmail.com</a>
            </li>
            <li>
              <a href="https://www.youtube.com/@ShiravZimra" target="_blank" rel="noopener">
                Shira v'Zimra on YouTube
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
  }

  .contact-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-block h3 {
    font-size: 1.25rem;
  }

  .contact-block p {
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  .contact-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .contact-links a {
    font-size: 0.95rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
    display: block;
    transition: opacity 0.15s;
  }

  .contact-links a:hover { opacity: 0.6; }

  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
