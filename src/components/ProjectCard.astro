---
interface Props {
  title: string;
  description: string;
  url?: string;
  githubUrl?: string;
  youtubeUrl?: string;
  tags?: string[];
  domain?: 'music' | 'engineering' | 'both';
}

const { title, description, url, githubUrl, youtubeUrl, tags = [], domain } = Astro.props;
---

<article class="project-card">
  {domain && <span class="project-domain" data-domain={domain}>{domain}</span>}
  <h3>{title}</h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tag-list">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
  {(url || githubUrl || youtubeUrl) && (
    <div class="card-links">
      {url && (
        <a href={url} target="_blank" rel="noopener" class="card-icon-link" title="Visit website">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          Website
        </a>
      )}
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener" class="card-icon-link" title="View source on GitHub">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
          GitHub
        </a>
      )}
      {youtubeUrl && (
        <a href={youtubeUrl} target="_blank" rel="noopener" class="card-icon-link" title="Watch on YouTube">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path fill="currentColor" d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.01-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>
          </svg>
          YouTube
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-domain {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-family: var(--font-sans);
  }

  h3 {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
  }

  p {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-top: 0.25rem;
  }

  .tag-list li {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    background: var(--color-surface);
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }

  .card-links {
    display: flex;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .card-icon-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-muted);
    transition: color 0.15s;
  }

  .card-icon-link:hover { color: var(--color-accent); }

  .card-icon-link svg { flex-shrink: 0; }
</style>
