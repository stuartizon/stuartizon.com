---
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  url?: string;
  githubUrl?: string;
  youtubeUrl?: string;
  tags?: string[];
  domain?: 'music' | 'engineering' | 'both';
}

const { title, description, url, githubUrl, youtubeUrl, tags = [], domain } = Astro.props;
---

<article class="project-card">
  {domain && <span class="project-domain" data-domain={domain}>{domain}</span>}
  <h3>{title}</h3>
  <p>{description}</p>
  {tags.length > 0 && (
    <ul class="tag-list">
      {tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
  {(url || githubUrl || youtubeUrl) && (
    <div class="card-links">
      {url && (
        <a href={url} target="_blank" rel="noopener" class="card-icon-link" title="Visit website">
          <Icon name="globe" size={15} />
          Website
        </a>
      )}
      {githubUrl && (
        <a href={githubUrl} target="_blank" rel="noopener" class="card-icon-link" title="View source on GitHub">
          <Icon name="github" size={15} />
          GitHub
        </a>
      )}
      {youtubeUrl && (
        <a href={youtubeUrl} target="_blank" rel="noopener" class="card-icon-link" title="Watch on YouTube">
          <Icon name="youtube" size={15} />
          YouTube
        </a>
      )}
    </div>
  )}
</article>

<style>
  .project-card {
    border: 1px solid var(--color-border);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-domain {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-family: var(--font-sans);
  }

  h3 {
    font-size: clamp(1.1rem, 2vw, 1.4rem);
  }

  p {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-top: 0.25rem;
  }

  .tag-list li {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    background: var(--color-surface);
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }

  .card-links {
    display: flex;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .card-icon-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-muted);
    transition: color 0.15s;
  }

  .card-icon-link:hover { color: var(--color-accent); }

  .card-icon-link svg { flex-shrink: 0; }
</style>
